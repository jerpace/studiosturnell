---
import BaseLayout from '../layouts/BaseLayout.astro';
import RiveMark from '../components/RiveMark.astro';
import { fetchSanity } from '../lib/sanity';

interface HomeContent {
  headline: string;
}

const fallback: HomeContent = {
  headline: 'Where brands become experiences',
};

const content = await fetchSanity<HomeContent>(
  `*[_type == "home"][0]{ "headline": headline.en }`,
  fallback
);
---

<BaseLayout title="Home" locale="en" path="/">
  <section class="home">
    <div class="home__scene">
      <div class="home__marquee">
        <div class="home__track">
          <div class="home__track-set">
            <div class="home__panel" />
            <div class="home__headline-panel">
              <h1 class="home__headline">{content.headline}</h1>
            </div>
            <div class="home__panel" />
            <div class="home__panel" />
          </div>

          <!-- Duplicate set for a seamless loop (visual repeat only). -->
          <div class="home__track-set" aria-hidden="true">
            <div class="home__panel" />
            <div class="home__headline-panel">
              <h1 class="home__headline">{content.headline}</h1>
            </div>
            <div class="home__panel" />
            <div class="home__panel" />
          </div>
        </div>
      </div>

      <!-- The S-mark sits fixed on top of the carousel banner — it does not
           scroll with the panels underneath it. Only one live instance is
           needed since it no longer repeats inside the track.

           It's rendered at 4x size and allowed to spill outside the hero
           section — including over the nav — so the murmuration has real
           room to fly across the page. The overlay itself has
           pointer-events disabled so that huge box never blocks clicks on
           the nav or anything else underneath it; a separate, normally
           sized hit-zone (same footprint the mark used to have) is what
           actually detects the hover and forwards it to the mark, via
           the inline script below. -->
      <div class="home__mark-overlay">
        <RiveMark class="home__mark" />
      </div>
      <div class="home__mark-hitzone" data-mark-hitzone aria-hidden="true"></div>
    </div>

    <div class="home__scene-mobile">
      <div class="home__mobile-image">
        <RiveMark class="home__mobile-mark" />
      </div>
      <h1 class="home__mobile-headline">{content.headline}</h1>
    </div>
  </section>
</BaseLayout>

<script>
  // The visible mark is now a large, click-through overlay (see the note in
  // the markup above), so hover is detected by a separate, normal-sized
  // hit-zone instead, and forwarded to the mark's own root element — the
  // same element RiveMark.astro's own script listens on. Only mouse
  // pointerenter/leave are forwarded here: this overlay only ever shows on
  // the desktop marquee (hidden below 900px), and the mobile layout has its
  // own separate, unaffected mark instance with its own touch handling.
  const hitzone = document.querySelector<HTMLElement>('[data-mark-hitzone]');
  const markRoot = document.querySelector<HTMLElement>('.home__mark[data-s-mark]');

  if (hitzone && markRoot) {
    hitzone.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') {
        markRoot.dispatchEvent(new PointerEvent('pointerenter', { pointerType: 'mouse' }));
      }
    });
    hitzone.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') {
        markRoot.dispatchEvent(new PointerEvent('pointerleave', { pointerType: 'mouse' }));
      }
    });
  }
</script>

<style>
  /*
    Desktop scene is positioned to match the Figma frame
    (sturnell_desktop-home-alt, 1728x882 content area) using percentages
    of that reference box, so it scales proportionally down to the
    mobile breakpoint, where a dedicated single-column layout takes over.
  */
  .home {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 0 clamp(20px, 2.66vw, 46px);
  }

  /*
    Endless right-to-left marquee: .home__track holds two identical
    .home__track-set copies side by side; animating it from translateX(0)
    to translateX(-50%) moves exactly one copy's width, so the loop point
    is invisible. .home__marquee clips the overflow.
  */
  .home__scene {
    position: relative;
  }

  .home__marquee {
    overflow: hidden;
    width: 100%;
    padding: clamp(32px, 4vw, 64px) 0;
  }

  /*
    Fixed over the carousel banner, centered — does not scroll with
    .home__track. Rendered at 4x the mark's old footprint and allowed to
    overflow the hero section entirely (no clipping ancestor, high
    z-index) so the murmuration can fly out over the nav and the rest of
    the page. pointer-events is off here — this box is mostly empty/
    transparent, and at this size it would otherwise sit on top of the
    nav and swallow clicks. See .home__mark-hitzone for the actual
    interactive area, and the page script that forwards its hover to
    the mark.
  */
  .home__mark-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(920px, 76vw, 1280px);
    aspect-ratio: 313 / 682;
    z-index: 20;
    pointer-events: none;
    overflow: visible;
  }

  /*
    Same footprint + position the mark itself used to have, before it was
    scaled up — this is what actually detects the hover (mouse only; see
    the page script), so the huge overlay above never blocks the nav or
    anything else underneath it.
  */
  .home__mark-hitzone {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(230px, 19vw, 320px);
    aspect-ratio: 313 / 682;
    z-index: 21;
    pointer-events: auto;
  }

  .home__track {
    display: flex;
    width: max-content;
    animation: home-marquee 55s linear infinite;
  }

  .home__marquee:hover .home__track {
    animation-play-state: paused;
  }

  .home__track-set {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: clamp(28px, 3.2vw, 64px);
    padding-right: clamp(28px, 3.2vw, 64px);
  }

  @keyframes home-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home__track {
      animation: none;
    }
  }

  .home__panel {
    position: relative;
    flex: 0 0 auto;
    width: clamp(230px, 19vw, 320px);
    aspect-ratio: 313 / 682;
    background: var(--placeholder);
    border-radius: 40px;
  }

  .home__headline-panel {
    flex: 0 0 auto;
    width: clamp(240px, 17vw, 320px);
  }

  .home__headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3vw, 50px);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
  }

  /*
    :global() is required here — RiveMark's root element only carries its
    own component's scope attribute, not index.astro's, so a plain scoped
    ".home__mark" selector silently never matches (Astro scoped-CSS gotcha
    for classes forwarded into a child component via a `class` prop).
    !important guards against the same equal-specificity ordering issue we
    hit last time. Positioned relative to .home__mark-overlay (same
    dimensions the old mark-host panel used), not a scrolling panel.

    width is 17.9%, not 72% — public/brand/s-mark-static.svg's viewBox
    used to have a lot of built-in empty margin around the ink (fixed
    separately, since it was quietly working against every width rule
    that referenced it), so this percentage is recalibrated to land at
    exactly 4x the mark's old on-page size inside the new 4x-larger
    .home__mark-overlay box, rather than 4x-of-4x by accident.
  */
  :global(.home__mark.home__mark) {
    position: absolute !important;
    left: 50% !important;
    top: 50% !important;
    transform: translate(-50%, -50%) !important;
    width: 17.9% !important;
    height: auto !important;
    z-index: 2 !important;
    pointer-events: none !important;
  }

  .home__scene-mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .home {
      padding: 0;
    }

    .home__marquee {
      display: none;
    }

    /* These two are siblings of .home__marquee, not children of it, so
       hiding the marquee alone left them showing on top of the mobile
       layout underneath (which has its own separate, correctly-sized
       mark in .home__mobile-image). */
    .home__mark-overlay,
    .home__mark-hitzone {
      display: none;
    }

    .home__scene-mobile {
      display: block;
    }

    .home__mobile-image {
      position: relative;
      width: 100%;
      height: 0;
      padding-top: 152.24%; /* 612 / 402 */
      background: var(--placeholder);
    }

    /* 13.4%, not 54% — same viewBox recalibration as the desktop mark
       above, keeping the mobile mark's on-page size unchanged (only the
       desktop carousel mark was asked to grow). */
    :global(.home__mobile-mark.home__mobile-mark) {
      position: absolute;
      left: 50%;
      top: 47%;
      transform: translate(-50%, -50%);
      width: 13.4%;
    }

    .home__mobile-headline {
      margin: 0;
      padding: 48px 24px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 34px;
      line-height: 0.9;
      text-align: center;
      text-transform: uppercase;
      color: var(--ink);
    }
  }
</style>
