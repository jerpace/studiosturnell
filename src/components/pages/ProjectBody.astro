---
export interface Props {
  locale: 'en' | 'mt';
  title: string;
  description: string;
  heroUrl: string | null;
  overlayUrls: string[];
}
const { locale, title, description, heroUrl, overlayUrls } = Astro.props;

const workHref = locale === 'en' ? '/work' : '/mt/work';
const cta = locale === 'en'
  ? { line1: "SO, WHAT'S YOUR BIG IDEA?", line2: "LET'S MAKE IT REAL" }
  : { line1: 'GĦANDEK IDEA KBIRA?', line2: 'ĦALLINA NAGĦMLUHA REALTÀ' };
const contactHref = locale === 'en' ? '/contact' : '/mt/contact';
---

<div class="project">
  <a href={workHref} class="project__back" aria-label="Back to work">←</a>

  <div class="project__hero" style={heroUrl ? `background-image:url(${heroUrl})` : undefined}>
    <div class="project__name-pill">{title}</div>
  </div>

  <div class="project__body">
    <p class="project__text">{description}</p>

    <div class="project__overlays">
      {overlayUrls.map((url) => (
        <div class="project__overlay" style={url ? `background-image:url(${url})` : undefined} />
      ))}
    </div>

    <a href={contactHref} class="project__cta">
      <p class="project__cta-text">
        {cta.line1}<br />{cta.line2}
      </p>
      <span class="project__cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  .project {
    position: relative;
  }

  .project__back {
    position: absolute;
    left: clamp(20px, 2.66vw, 46px);
    top: 208px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 57px;
    height: 56px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 28px;
    text-decoration: none;
  }

  .project__hero {
    position: relative;
    width: 100%;
    aspect-ratio: 1728 / 960;
    background: var(--placeholder) center / cover no-repeat;
  }

  .project__name-pill {
    position: absolute;
    left: clamp(20px, 5.5vw, 95px);
    bottom: 40px;
    max-width: 440px;
    padding: 16px 24px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 38px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .project__body {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 80px clamp(20px, 2.66vw, 46px) 0;
  }

  .project__text {
    max-width: 949px;
    margin: 0 0 64px auto;
    font-size: clamp(18px, 1.74vw, 30px);
    line-height: 1.5;
    color: var(--ink);
    white-space: pre-wrap;
  }

  .project__overlays {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .project__overlay {
    width: 100%;
    aspect-ratio: 1498 / 938;
    border-radius: 10px;
    background: var(--placeholder) center / cover no-repeat;
  }

  .project__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    max-width: 480px;
    margin: 96px auto;
    text-decoration: none;
  }

  .project__cta-text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.3;
    color: var(--ink);
  }

  .project__cta-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 10px;
    background: var(--ink);
    color: var(--paper);
    font-size: 28px;
  }

  @media (max-width: 900px) {
    .project__back {
      top: 170px;
      width: 48px;
      height: 48px;
    }

    .project__name-pill {
      left: 16px;
      bottom: -20px;
      font-size: 18px;
      padding: 12px 16px;
    }

    .project__body {
      padding: 48px 24px 0;
    }

    .project__text {
      margin: 0 0 40px 0;
    }

    .project__cta {
      flex-direction: column;
      gap: 24px;
      text-align: center;
      margin: 64px auto;
    }
  }
</style>
