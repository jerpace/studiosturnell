---
import { fetchSanity, sanityConfigured } from '../../lib/sanity';

export interface Props {
  locale: 'en' | 'mt';
}
const { locale } = Astro.props;

interface Project {
  slug: string;
  title: string;
  client: string;
  thumbnailUrl: string | null;
}

const fallback: Project[] = [1, 2, 3, 4, 5, 6].map((n) => ({
  slug: `project-${n}`,
  title: 'Project Name',
  client: 'Client',
  thumbnailUrl: null,
}));

const projects = sanityConfigured
  ? await fetchSanity<Project[]>(
      `*[_type == "project"] | order(order asc) {
        "slug": slug.current,
        "title": title.${locale},
        "client": client.${locale},
        "thumbnailUrl": thumbnail.asset->url
      }`,
      fallback
    )
  : fallback;

const list = projects && projects.length > 0 ? projects : fallback;
const workHref = locale === 'en' ? '/work' : '/mt/work';
---

<section class="work">
  <div class="work__grid">
    {list.map((project) => (
      <a href={`${workHref}/${project.slug}`} class="work__card">
        <div class="work__image" style={project.thumbnailUrl ? `background-image:url(${project.thumbnailUrl})` : undefined} />
        <div class="work__caption">
          <p class="work__client">{project.client || 'Client'}</p>
          <p class="work__title">{project.title || 'Project Name'}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .work {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: clamp(20px, 1.8vw, 47px) clamp(20px, 2.72vw, 47px) 80px;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px 28px;
  }

  .work__card {
    position: relative;
    display: block;
    aspect-ratio: 520 / 380;
    border-radius: 10px;
    border: 2px solid var(--ink);
    overflow: hidden;
    text-decoration: none;
  }

  .work__image {
    position: absolute;
    inset: 0;
    background: var(--placeholder) center / cover no-repeat;
  }

  .work__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 16px 24px;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(6px);
    transform: translateY(100%);
    transition: transform 0.25s ease;
  }

  .work__card:hover .work__caption,
  .work__card:focus-visible .work__caption {
    transform: translateY(0);
  }

  .work__client {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--ink);
  }

  .work__title {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 20px;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .work {
      padding: 24px 24px 64px;
    }

    .work__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .work__client {
      font-size: 22px;
    }

    .work__title {
      font-size: 15px;
    }
  }
</style>
